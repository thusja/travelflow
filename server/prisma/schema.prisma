generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id
  nickname            String?
  firstname           String?
  lastname            String?
  email               String               @unique
  password            String
  phone               String?
  profileImage        String?              @map("profileImage")
  notifications       String?
  isDeleted           Boolean              @default(false) @map("is_deleted")
  deletedAt           DateTime?            @map("deleted_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  bookings            Booking[]
  loginLogs           LoginLog[]
  reviews             Review[]
  userCoupons         UserCoupon[]
  withdrawalLogs      WithdrawalLog[]
  refreshTokens       RefreshToken[]
  idempotencyRequests IdempotencyRequest[]
  pointHistories      PointHistory[]

  @@map("users")
}

model Package {
  id       String    @id
  title    String
  bookings Booking[]

  @@map("packages")
}

model Booking {
  id          String   @id
  userId      String   @map("user_id")
  packageId   String   @map("package_id")
  status      String
  bookingDate DateTime @map("booking_date")
  pkg         Package  @relation(fields: [packageId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  reviews     Review[]

  @@map("bookings")
}

model Review {
  id        String    @id
  userId    String    @map("user_id")
  bookingId String    @map("booking_id")
  rating    Int
  comment   String?
  imageUrl  String?   @map("image_url")
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")
  booking   Booking   @relation(fields: [bookingId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model Coupon {
  id          Int          @id
  code        String       @unique
  name        String
  expireAt    DateTime     @map("expire_at")
  userCoupons UserCoupon[]

  @@map("coupons")
}

model UserCoupon {
  id         String   @id
  userId     String   @map("user_id")
  couponId   Int      @map("coupon_id")
  status     String
  assignedAt DateTime @default(now()) @map("assigned_at")
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, couponId])
  @@map("usercoupons")
}

model LoginLog {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("login_logs")
}

model WithdrawalLog {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  reason    String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("withdrawal_logs")
}

model PointHistory {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id")
  description String
  amount      Int
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id])

  @@map("point_histories")
}

model IdempotencyRequest {
  id             String   @id
  userId         String?  @map("user_id")
  idempotencyKey String   @map("idempotency_key")
  method         String
  path           String
  requestHash    String   @map("request_hash")
  state          String   @default("pending")
  statusCode     Int?     @map("status_code")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User?    @relation(fields: [userId], references: [id])

  @@unique([userId, idempotencyKey, method, path])
  @@map("idempotency_requests")
}

model RefreshToken {
  id                String    @id
  userId            String    @map("user_id")
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  user              User      @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model TripPlan {
  id          String   @id
  destination String
  travelDate  DateTime @map("travel_date")
  memo        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("trip_plans")
}

model TravelSuggestion {
  id          String   @id
  destination String
  content     String
  status      String   @default("received")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("travel_suggestions")
}
