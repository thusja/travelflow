generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id
  nickname       String?
  firstname      String?
  lastname       String?
  email          String          @unique
  password       String
  phone          String?
  profileImage   String?
  notifications  String?
  is_deleted     Boolean         @default(false)
  deleted_at     DateTime?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  loginLogs      LoginLog[]
  withdrawalLogs WithdrawalLog[]
  reviews        Review[]
  bookings       Booking[]
  userCoupons    UserCoupon[]

  @@map("users")
}

model LoginLog {
  id         Int      @id @default(autoincrement())
  user_id    String
  ip         String?
  user_agent String?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])

  @@map("login_logs")
}

model WithdrawalLog {
  id         Int      @id @default(autoincrement())
  user_id    String
  reason     String
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])

  @@map("withdrawal_logs")
}

model Review {
  id         String    @id
  user_id    String
  booking_id String
  rating     Int
  comment    String?
  image_url  String?
  is_deleted Boolean   @default(false)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  user       User      @relation(fields: [user_id], references: [id])
  booking    Booking   @relation(fields: [booking_id], references: [id])

  @@map("reviews")
}

model Booking {
  id           String   @id
  user_id      String
  package_id   String
  status       String
  booking_date DateTime
  user         User     @relation(fields: [user_id], references: [id])
  package      Package  @relation(fields: [package_id], references: [id])
  reviews      Review[]

  @@map("bookings")
}

model Package {
  id       String    @id
  title    String
  bookings Booking[]

  @@map("packages")
}

model Coupon {
  id         Int          @id
  code       String       @unique
  name       String
  expire_at  DateTime
  userCoupons UserCoupon[]

  @@map("coupons")
}

model UserCoupon {
  id         String   @id
  user_id    String
  coupon_id  Int
  status     String
  assigned_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
  coupon     Coupon   @relation(fields: [coupon_id], references: [id])

  @@unique([user_id, coupon_id])
  @@map("usercoupons")
}
