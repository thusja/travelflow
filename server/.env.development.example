# Development
NODE_ENV=development
PORT=5000

# Database (development)
DATABASE_URL=postgresql://postgres:<password>@db.<dev-project-ref>.supabase.co:5432/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:<password>@db.<dev-project-ref>.supabase.co:5432/postgres

# JWT
JWT_SECRET=change_this_dev_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_this_dev_refresh_secret
REFRESH_EXPIRES_IN=14d

# External APIs
EXCHANGE_API_KEY=
WEATHER_API_KEY=
VITE_WEATHER_API_KEY=

# Redis cache (optional)
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=1500

# Cache TTL (seconds)
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_TTL_PACKAGES_SECONDS=120
CACHE_TTL_EXTERNAL_API_SECONDS=300
CACHE_TTL_WEATHER_CURRENT_SECONDS=180
CACHE_TTL_WEATHER_CITY_SECONDS=180

# Scripts (optional)
SMOKE_USER_ID=
