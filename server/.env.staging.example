# Staging
NODE_ENV=staging
PORT=5000

# Database (staging)
DATABASE_URL=postgresql://postgres:<password>@db.<staging-project-ref>.supabase.co:5432/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:<password>@db.<staging-project-ref>.supabase.co:5432/postgres

# JWT
JWT_SECRET=change_this_staging_secret
JWT_EXPIRES_IN=1d

# External APIs
EXCHANGE_API_KEY=
WEATHER_API_KEY=
VITE_WEATHER_API_KEY=

# Scripts (optional)
SMOKE_USER_ID=
